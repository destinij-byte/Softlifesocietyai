{
  "expo": {
    "name": "Soft Life Society",
    "slug": "soft-life-society",
    "scheme": "softlifesociety",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8E4DC"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.softlifesocietyai.app"
    },
    "android": {
      "package": "ai.softlifesocietyai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F8E4DC"
      }
    },
    "plugins": ["expo-router", "expo-font"],
    "extra": {
      "apiUrl": "http://localhost:8000"
    }
  }
}
