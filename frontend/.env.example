# Optional: real in-app purchases via RevenueCat's client SDK. These are the
# platform *public* SDK keys from your RevenueCat project (Project Settings ->
# API Keys) — never the secret key, which lives only in backend/.env. Leave
# both unset in dev/Expo Go: the paywall falls back to a clear "purchases
# aren't available in this build" message instead of crashing. Must be
# prefixed EXPO_PUBLIC_ so Expo inlines them at build time (see
# https://docs.expo.dev/guides/environment-variables/). Also requires a
# custom EAS dev/production client build — react-native-purchases is a native
# module and does not run in Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
