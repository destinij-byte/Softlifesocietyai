ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=softlifesociety
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRIAL_LENGTH_DAYS=7

# Comma-separated list of origins allowed to call this API. Add your deployed
# frontend URL(s) here; the defaults only cover local Expo dev.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:19000

# Optional: powers Luna's real coaching replies via the Claude API.
# Leave unset to use the built-in templated responses (no API calls, no cost).
ANTHROPIC_API_KEY=
LUNA_MODEL=claude-opus-5
