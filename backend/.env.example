ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=softlifesociety
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRIAL_LENGTH_DAYS=7

# Comma-separated list of origins allowed to call this API. Add your deployed
# frontend URL(s) here; the defaults only cover local Expo dev.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:19000

# Optional: powers Luna's real coaching replies via the Claude API.
# Leave unset to use the built-in templated responses (no API calls, no cost).
ANTHROPIC_API_KEY=
LUNA_MODEL=claude-opus-5

# Optional: real subscription entitlement verification via RevenueCat.
# REVENUECAT_SECRET_API_KEY is the server-to-server "secret" key from your
# RevenueCat project settings (never the public SDK key). REVENUECAT_WEBHOOK_SECRET
# is a value you choose and set as the Authorization header in RevenueCat's
# dashboard under Project Settings -> Webhooks. Leave both unset in dev —
# subscription sync/webhook endpoints fail closed without them.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# Optional: transactional email (password reset) via Resend (resend.com).
# Leave RESEND_API_KEY unset in dev — reset tokens are logged server-side instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Soft Life Society <onboarding@resend.dev>
